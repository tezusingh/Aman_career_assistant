# ============================================================================
# career-ops (Fighter90 fork) — provider config
# Copy to  career-ops/.env  and paste your keys (bootstrap does this for you).
# Switch the active provider by editing LLM_PROVIDER below.
#   claude  -> uses ANTHROPIC_API_KEY
#   openai  -> uses OPENAI_API_KEY
# The web-ui (#/config) can also switch this live without restarting.
# ============================================================================

LLM_PROVIDER=claude

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Optional fallbacks (leave blank if unused) ──────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
