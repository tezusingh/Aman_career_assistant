# ============================================================================
# JobOps — provider config
# Copy to  job-ops/.env  and paste your keys (bootstrap does this for you).
# Switch provider by editing MODEL + LLM_PROVIDER (or use the onboarding wizard).
#   OpenAI : LLM_PROVIDER=openai      MODEL=gpt-4o
#   Claude : LLM_PROVIDER=claude_cli  MODEL=anthropic/claude-sonnet-4-6
#            (claude_cli reads ANTHROPIC_API_KEY from this file)
# ============================================================================

MODEL=gpt-4o
LLM_PROVIDER=openai

# ── API keys (both present so you can switch freely) ────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional integrations (fill only if you use them) ───────────────────────
# Reactive Resume (tailored resume export) — optional; local PDF works without it
RXRESUME_API_KEY=
# Adzuna multi-country job API (good for India + global) — optional
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Gmail tracking (auto-detect interview/offer/rejection emails) — optional
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
